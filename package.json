{
  "name": "pubudu-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://pubudu-tharanga.vercel.app/",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.js",
    "build": "npm run sitemap && vite build && node scripts/inject-preload.js && node scripts/generate-critical.js",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "push": "bash deploy.sh",
    "push:ps": "powershell -ExecutionPolicy Bypass -File deploy.ps1",
    "ship": "bash deploy.sh"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "three-globe": "^2.45.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "critical": "^8.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "terser": "^5.51.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
